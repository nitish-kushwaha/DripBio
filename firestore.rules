# ============================================================
# DripBio.bond — Firestore Security Rules (v3)
# Paste ALL of this in:
# Firebase Console → Firestore → Rules → Publish
# ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──────────────────────────────────────
    match /users/{uid} {
      allow read: if true;

      // Owner can create their own doc
      allow create: if request.auth != null && request.auth.uid == uid;
      
      // Owner can update, but if they are verifying (isVerified == true), they MUST provide mandatory fields
      allow update: if request.auth != null && request.auth.uid == uid
        && (
          (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) 
          || 
          (
            'mobileNumber' in request.resource.data &&
            'altMobileNumber' in request.resource.data &&
            'dateOfBirth' in request.resource.data &&
            'gender' in request.resource.data &&
            'city' in request.resource.data &&
            'address' in request.resource.data
          )
        );
      allow delete: if false;

      // Links subcollection
      match /links/{linkId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;

        // Owner can update fully; anyone can increment 'clicks' only
        allow update: if (request.auth != null && request.auth.uid == uid)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']);
      }
    }

    // ── Username index ────────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      // Only allow create if username doc doesn't exist yet (server-side uniqueness)
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if false;
    }

  }
}
